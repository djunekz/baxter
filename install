menu(){
echo
echo -e ${lyellow}" Select OS for Installing"${cyan}":"
echo
echo -e ${lgreen}"["${yellow}"1"${lgreen}"]" ${white}" Termux"
echo -e ${lgreen}"["${yellow}"2"${lgreen}"]" ${white}" Linux"
echo ""
echo -ne ${white}" Select" ${lgreen}" > "
read opt
if [ $opt = "1" ];
then
termux
elif [ $opt = "2" ];
then
linux
else
echo -e ${lred}" Wrong input! please try again type" ${lyellow}"Bash Install"
fi
}
menu
